# ---------- Required to run ----------
# Posting provider: postforme | uploadpost | postproxy | none
#   none = free manual mode: Approve only marks the clip, you download it from the GUI and post it yourself
#   Several at once: POSTER_PROVIDER=postproxy,uploadpost  (account ids then look like postproxy/<id>)
POSTER_PROVIDER=postforme
# Only the key of the selected provider is needed (connect your TikTok/IG/YouTube accounts on their site)
# Post for Me: https://www.postforme.dev
POSTFORME_API_KEY=
# Upload-Post: https://www.upload-post.com
UPLOADPOST_API_KEY=
# Postproxy: https://postproxy.dev
POSTPROXY_API_KEY=
# Discord channel webhook (Channel settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=
# GUI login (set a password if the app is reachable from the internet)
GUI_USER=admin
GUI_PASSWORD=change-me
# Public URL of this app (used for the review link inside Discord messages)
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Platform APIs: fill in the ones you want to track ----------
# Twitch: https://dev.twitch.tv/console/apps  (register app, Client Credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: https://kick.com/settings/developer  (create app)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# YouTube: Google Cloud Console > enable "YouTube Data API v3" > API key
YOUTUBE_API_KEY=

# ---------- Optional ----------
DATA_DIR=./data
PORT=8000
LOG_LEVEL=INFO
# Largest file the Discord webhook may attach, in MB. The clip preview is encoded to fit this, so a
# higher limit (boosted servers allow more) means a sharper preview. Full-quality clips are in the GUI.
# DISCORD_MAX_UPLOAD_MB=8

# On-screen headline between cam and game, written by Claude from what was said (console.anthropic.com).
# Without a key there is no headline (Settings -> headline_mode = local gives a rough free one).
ANTHROPIC_API_KEY=
# Speech-to-text model for the headline: small.en (default, ~0.5 GB), base.en / tiny.en are faster but rougher
# WHISPER_MODEL=small.en
# Any tunable can also be set here in UPPERCASE (or edited live in the GUI), e.g.
# Z_THRESHOLD=3.0  PRE_ROLL_S=40  POST_ROLL_S=15  CHUNK_SECONDS=600  POLL_SECONDS=120  AUTO_APPROVE=false
